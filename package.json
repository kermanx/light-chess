{
  "name": "light-chess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "relay": "node scripts/dev-mqtt-relay.mjs",
    "relay:nostr": "node scripts/dev-relay.mjs",
    "build": "vue-tsc -b && vite build && node scripts/gen-404.mjs",
    "preview": "vite preview",
    "build:ai": "node scripts/build-ai.mjs",
    "predev": "npm run build:ai",
    "prebuild": "npm run build:ai",
    "test:opening": "npx tsx scripts/opening-check.ts && npx tsx scripts/opening-tactics-check.ts",
    "test:ai": "cargo test --manifest-path ai/Cargo.toml && npm run build:ai && node scripts/ai-engine-check.mjs && npx tsx scripts/ai-integration-check.ts && npx tsx scripts/ai-clock-check.ts && node scripts/ai-strategy-check.mjs && npx tsx scripts/ai-analysis-check.ts",
    "test:ai-page": "npm run build && npx tsx scripts/ai-test-export-check.ts && node scripts/ai-test-page-check.mjs && node scripts/ai-preview-update-check.mjs",
    "build:dsh": "node scripts/build-dsh.mjs",
    "build:with-dsh": "npm run build:dsh && npm run build",
    "test:ai-providers": "npx tsx scripts/ai-provider-check.ts && node scripts/ai-provider-browser-check.mjs",
    "test:llm-profiles": "npm run build && node scripts/llm-profiles-page-check.mjs",
    "test:dsh": "npx tsx scripts/dsh-tools-check.ts && node scripts/dsh-browser-check.mjs",
    "test:dsh-trajectory": "node scripts/dsh-trajectory-check.mjs",
    "test:dsh-activity": "npx tsx scripts/dsh-activity-check.ts",
    "test:dsh-retry": "node scripts/dsh-retry-check.mjs",
    "test:replay": "npm run build && node scripts/replay-check.mjs",
    "arena": "node scripts/dsh-arena.mjs",
    "test:dsh-arena": "node scripts/dsh-arena-check.mjs && node scripts/dsh-preset-check.mjs"
  },
  "dependencies": {
    "@deepseek-ai/trajectory-ui": "file:vendor/trajectory-ui",
    "@trystero-p2p/mqtt": "^0.25.3",
    "mqtt": "^5.16.1",
    "trystero": "^0.25.3",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@iconify-json/codicon": "^1.2.76",
    "@types/node": "^24.13.2",
    "@unocss/preset-icons": "^66.12.0",
    "@unocss/preset-uno": "^66.12.0",
    "@unocss/transformer-directives": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "aedes": "^0.51.3",
    "playwright": "^1.62.0",
    "rolldown": "1.1.5",
    "typescript": "~6.0.2",
    "unocss": "^66.12.0",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5",
    "ws": "^8.21.1"
  }
}

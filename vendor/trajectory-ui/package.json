{
  "name": "@deepseek-ai/trajectory-ui",
  "version": "0.1.0",
  "description": "A dense, streaming trajectory ledger for Vue applications.",
  "type": "module",
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./style.css": "./src/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node artifact/server/index.js",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "busboy": "^1.6.0",
    "client-zip": "^2.5.0",
    "katex": "^0.16.47",
    "libarchive-wasm": "^1.2.0",
    "markdown-it": "^14.3.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-katex": "^2.0.3",
    "nanoid": "^5.1.16",
    "shiki": "^4.3.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-format-catalog": "0.2.2-alpha.2",
    "@iconify-json/codicon": "^1.2.45",
    "@noble/hashes": "2.0.1",
    "@types/archiver": "^8.0.0",
    "@types/busboy": "^1.5.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.3.0",
    "@unocss/preset-icons": "^66.5.1",
    "@unocss/preset-uno": "^66.5.1",
    "@unocss/transformer-directives": "^66.5.1",
    "@unocss/vite": "^66.5.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "unocss": "^66.5.1",
    "vite": "^7.1.3",
    "vue": "^3.5.20",
    "vue-tsc": "^3.0.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT"
}
